#!/usr/bin/env bash
# Displays DNS record information for specified domain subdomains

display_record() {
    local domain="$1"
    local sub="$2"
    local info
    info=$(dig "$sub.$domain" | grep -A1 'ANSWER SECTION:' | tail -n 1)
    local record_type
    record_type=$(echo "$info" | awk '{print $4}')
    local destination
    destination=$(echo "$info" | awk '{print $5}')
    echo "The subdomain $sub is a $record_type record and points to $destination"
}

if [ $# -eq 1 ]; then
    for sub in www lb-01 web-01 web-02; do
        display_record "$1" "$sub"
    done
elif [ $# -eq 2 ]; then
    display_record "$1" "$2"
fi
